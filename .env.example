# Ollama runs on the host, not in Docker. This default is for running the
# app natively (outside Docker). docker-compose.yml overrides this to
# http://host.docker.internal:11434/v1 for the api/worker containers.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3.5:latest

# Default is for running natively. docker-compose.yml overrides this to
# temporal:7233 for the api/worker containers (the compose service name).
TEMPORAL_ADDRESS=localhost:7233

TASK_QUEUE=fraud-hold-task-queue
FRAUD_SCORE_THRESHOLD=70

# Demo-only: adds a delay inside lookup_customer_channel_preference so a Worker
# can be terminated while the tool Activity is in flight -- only used for the
# manual Worker-pod-failover demo (README, "Demo C").
# Must remain below the 10-second tool Activity start_to_close_timeout, or the
# Activity will time out on its own (forcing the Agent's fallback path) even
# with the Worker left running normally -- that's not what the demo is for.
# Normal usage: 0. Demo C suggested value: 8.
DEMO_FAILOVER_DELAY_SECONDS=0
DEMO_MODEL_RETRY_INTERVAL_SECONDS=1
